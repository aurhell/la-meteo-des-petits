# Configuration d'environnement
# ============================================
# IMPORTANT: Ce fichier doit être copié en .env.local
# Le fichier .env.local est IGNORÉ par Git et restera PRIVÉ
#
# ⚠️  NE JAMAIS committer .env.local avec des clés réelles!
# ============================================

# ELEVENLABS API Key (Optionnel)
# ============================================
# Obtenez une clé gratuite sur https://elevenlabs.io/sign-up
# 10,000 caractères gratuits par mois
#
# ⚠️  SÉCURITÉ IMPORTANTE:
# Cette clé sera exposée dans le code JavaScript côté client.
# Ce n'est pas idéal mais c'est le modèle de cette PWA.
# - NE partagez jamais ce fichier avec d'autres personnes
# - Régénérez la clé si vous pensez qu'elle a été compromise
# - Considérez un backend pour des cas sensibles
#
VITE_ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Default coordinates for weather (Optionnel)
# ============================================
# Localisation par défaut si la géolocalisation échoue
# Format: latitude décimale, longitude décimale
# Exemple: Rennes, France (48.117°N, 1.677°W)
#
VITE_DEFAULT_LATITUDE=48.117
VITE_DEFAULT_LONGITUDE=-1.677

# Debug mode (Optionnel)
# ============================================
# Affiche le bouton debug pour tester les saisons/météo
# Par défaut: visible en dev seulement, caché en prod
# Décommentez pour forcer la visibilité ou la masquer
#
VITE_DEBUG_MODE=false
